<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>Prueba dos cámaras</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>
:root{--bg:#f5f5f7;--fg:#111;--card:#fff;--ac:#d9480f;--mu:#666;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#111;--fg:#f2f2f2;--card:#1d1d1f;--mu:#999}}
:root[data-theme="dark"]{--bg:#111;--fg:#f2f2f2;--card:#1d1d1f;--mu:#999}
body{margin:0;background:var(--bg);color:var(--fg);font-family:-apple-system,system-ui,sans-serif;padding:16px;max-width:520px;margin-inline:auto}
h1{font-size:20px;margin:4px 0 10px}
.row{display:flex;gap:8px}
.row>div{flex:1}
video{width:100%;aspect-ratio:3/4;object-fit:cover;background:#000;border-radius:10px}
button{width:100%;padding:12px;border:0;border-radius:12px;font-size:15px;font-weight:600;background:var(--ac);color:#fff;margin-top:8px}
p,small{color:var(--mu);font-size:13px}
#res{font-size:16px;font-weight:700;margin:10px 0}
pre{background:var(--card);padding:10px;border-radius:10px;font-size:12px;white-space:pre-wrap;overflow-x:auto}
</style>
</head>
<body>
<h1>🧪 Prueba: dos cámaras a la vez</h1>
<p>Toca una prueba. Si las dos imágenes se mueven en vivo al mismo tiempo, Safari sí lo permite. Mueve la mano frente a las cámaras.</p>
<div class="row">
<div><small>Cámara 1</small><video id="v1" playsinline muted autoplay></video></div>
<div><small>Cámara 2</small><video id="v2" playsinline muted autoplay></video></div>
</div>
<button id="a">Prueba A: trasera y luego frontal</button>
<button id="b">Prueba B: frontal y luego trasera</button>
<button id="c">Prueba C: por dispositivo (deviceId)</button>
<div id="res"></div>
<pre id="log"></pre>
<script>
const $=id=>document.getElementById(id);
let streams=[];
const log=t=>{$("log").textContent+=t+"\n"};
const wait=ms=>new Promise(r=>setTimeout(r,ms));
function stopAll(){streams.forEach(s=>s.getTracks().forEach(t=>t.stop()));streams=[];$("v1").srcObject=null;$("v2").srcObject=null}
async function cam(c,el){
  const s=await navigator.mediaDevices.getUserMedia(c);
  streams.push(s);el.srcObject=s;await el.play().catch(()=>{});return s;
}
async function check(s,el,name){
  const t=s.getVideoTracks()[0],c0=el.currentTime;
  await wait(800);
  const moving=el.currentTime>c0;
  log(name+": estado="+t.readyState+", silenciada="+t.muted+", avanza="+moving+", tamaño="+el.videoWidth+"x"+el.videoHeight);
  return t.readyState==="live"&&!t.muted&&moving;
}
async function run(mode){
  stopAll();$("log").textContent="";$("res").textContent="Probando...";
  try{
    let c1,c2;
    const fm=(f,a)=>({video:{facingMode:{ideal:f}},audio:a});
    if(mode==="a"){c1=fm("environment",false);c2=fm("user",true)}
    else if(mode==="b"){c1=fm("user",true);c2=fm("environment",false)}
    else{
      const tmp=await navigator.mediaDevices.getUserMedia({video:true});tmp.getTracks().forEach(t=>t.stop());
      const d=(await navigator.mediaDevices.enumerateDevices()).filter(x=>x.kind==="videoinput");
      d.forEach(x=>log("dispositivo: "+x.label));
      const back=d.find(x=>/back|rear|trasera/i.test(x.label)),front=d.find(x=>/front|frontal/i.test(x.label));
      if(!back||!front){$("res").textContent="No se encontraron las dos cámaras por nombre.";return}
      c1={video:{deviceId:{exact:back.deviceId}},audio:false};c2={video:{deviceId:{exact:front.deviceId}},audio:true};
    }
    const s1=await cam(c1,$("v1"));log("Cámara 1 abierta");
    await wait(1000);
    const s2=await cam(c2,$("v2"));log("Cámara 2 abierta");
    await wait(1500);
    const ok1=await check(s1,$("v1"),"Cámara 1"),ok2=await check(s2,$("v2"),"Cámara 2");
    $("res").textContent=(ok1&&ok2)?"✅ Las dos cámaras siguen en vivo":"❌ Solo una cámara se mantiene en vivo";
  }catch(e){$("res").textContent="Error: "+e.name;log(String(e))}
}
$("a").onclick=()=>run("a");$("b").onclick=()=>run("b");$("c").onclick=()=>run("c");
</script>
</body>
</html>
